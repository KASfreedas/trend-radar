# Trend Radar — secrets template (05_DATA_SOURCES.md)
# Copy to .env and fill in. Save as UTF-8 WITHOUT BOM (use VS Code or PowerShell,
# not Notepad). Never commit .env.

# --- Scrapers (Phase 1) ---
APIFY_TOKEN=                 # Apify actor token (Instagram, TikTok, Pinterest)

# --- Reddit official API (optional, Phase 4) ---
# Free: register a "script" app at reddit.com/prefs/apps (~2 min). Blank =
# falls back to public RSS feeds, which work but get 429-throttled in bursts.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TrendRadarBot/1.0

# --- Synthesis (Phase 2, briefing/synthesize.py) ---
LLM_API_KEY=                 # Anthropic API key; if blank, deterministic synthesis is used
LLM_MODEL=claude-sonnet-4-6  # optional override

# --- Email delivery (Phase 2, briefing/send.py) ---
EMAIL_API_KEY=               # transactional provider key (Resend by default); blank = dry run
EMAIL_PROVIDER=resend        # currently supported: resend
EMAIL_FROM=Trend Radar <onboarding@resend.dev>   # verified sender
CLIENT_EMAIL=                # briefing recipient (the owner)
OPERATOR_EMAIL=              # you — receives failure alerts

# --- Reliability (Phase 4) ---
ENABLE_SCHEDULER=0           # 1 = run the weekly refresh + monthly send cron in-process
                              # (see scheduler.py). Only turn on once deployed somewhere
                              # that stays up. Day/hour are Settings → Schedule editable.
APP_PASSWORD=                # blank = no login gate (local dev). Set before any
                              # public/non-localhost deploy to gate the whole app.
                              # Enforced: app.py refuses to bind a non-loopback
                              # HOST while this is blank.
FLASK_SECRET_KEY=            # stable session signing key; blank = random per boot
                              # (all logins reset on every restart)

# --- Server binding (deployment) ---
HOST=127.0.0.1               # 0.0.0.0 for container/hosted deploys (requires APP_PASSWORD)
PORT=5050
AUTO_REFRESH=0               # 1 = scrape on boot (spends Apify credits every restart)
